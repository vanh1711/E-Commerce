# Application settings
APP_NAME=PhoneStore
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-service-name.onrender.com
APP_KEY=base64:your_generated_app_key_here
TRUSTED_PROXIES=*

# Database settings (Aiven MySQL)
DB_CONNECTION=mysql
DB_HOST=mysql-your-instance.aivencloud.com
DB_PORT=16933
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=your_aiven_password_here
MYSQL_ATTR_SSL_CA=/etc/secrets/ca.pem

# Session, Cache & Queue settings
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Port & Initialization Flags
PORT=10000
RUN_MIGRATIONS=true
RUN_SEEDERS=false

# Initial Admin Seeding (Bật khi khởi tạo lần đầu, tắt sau khi chạy xong)
SEED_ADMIN_NAME="Shop Admin"
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=AdminPassword123!

# Mail settings
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=PhoneStore

# Payment & Shipping 3rd Party Integrations (Optional)
MOMO_PARTNER_CODE=MOMO_DEMO
MOMO_ACCESS_KEY=MOMO_ACCESS_KEY
MOMO_SECRET_KEY=MOMO_SECRET_KEY
MOMO_REDIRECT_URL=https://your-service-name.onrender.com/payment/momo/callback
MOMO_IPN_URL=https://your-service-name.onrender.com/payment/momo/ipn
MOMO_VERIFY_SSL=true

GHN_API_TOKEN=your_ghn_token_here
GHN_SHOP_ID=your_ghn_shop_id_here
GHN_VERIFY_SSL=true
